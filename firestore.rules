rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn()
        && adminDoc().data.admin == true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.admin == false;

      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.admin == resource.data.get('admin', false);

      allow update: if isAdmin()
        && userId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admin', 'updatedAt']);

      allow delete: if isOwner(userId);

      allow delete: if isAdmin()
        && userId != request.auth.uid
        && get(/databases/$(database)/documents/users/$(userId)).data.get('admin', false) == false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || guestShareEventUpdate(eventId);
    }

    function shareLinkDoc(shareId) {
      return get(/databases/$(database)/documents/eventShareLinks/$(shareId));
    }

    function shareLinkEditable(shareId) {
      let link = shareLinkDoc(shareId).data;
      return link.active == true
        && (link.expiresAt == null || link.expiresAt > request.time);
    }

    function guestShareEventUpdate(eventId) {
      let shareId = request.resource.data._shareEditId;
      return shareId is string
        && shareId.size() >= 32
        && exists(/databases/$(database)/documents/eventShareLinks/$(shareId))
        && shareLinkDoc(shareId).data.eventId == eventId
        && shareLinkEditable(shareId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'slug',
          'dateStart',
          'timeStart',
          'dateEnd',
          'timeEnd',
          'place',
          'placeLat',
          'placeLng',
          'price',
          'description',
          'organisers',
          'participants',
          'registrationLink',
          'report',
          'galleryLink',
          'coverImage',
          'coverPublicId',
          'coverPatternSeed',
          'promoImages',
          'galleryPicks',
          'category',
          'externalPageEnabled',
          'externalPageUrl',
          'calendarOnly',
          'published',
          'updatedAt',
          '_shareEditId',
        ]);
    }

    match /eventShareLinks/{shareId} {
      allow read: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'eventId',
          'expiresAt',
          'maxUses',
          'openCount',
          'active',
          'label',
          'createdAt',
          'createdBy',
        ])
        && request.resource.data.eventId is string
        && request.resource.data.openCount == 0
        && request.resource.data.active == true;
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || guestShareLinkOpenUpdate();
    }

    function guestShareLinkOpenUpdate() {
      let link = resource.data;
      let next = request.resource.data;
      let currentOpens = link.get('openCount', 0);
      return next.diff(link).affectedKeys().hasOnly(['openCount', 'lastOpenedAt'])
        && next.openCount == currentOpens + 1
        && link.get('active', false) == true
        && (link.get('expiresAt', null) == null || link.get('expiresAt', null) > request.time)
        && (link.get('maxUses', null) == null || currentOpens < link.get('maxUses', null));
    }

    function hasCompleteProfile() {
      return isSignedIn()
        && adminDoc().data.name is string
        && adminDoc().data.name.size() > 0;
    }

    function isBlogPostAuthor(data) {
      return isSignedIn()
        && data.author is map
        && data.author.uid == request.auth.uid;
    }

    function validBlogAuthor(author) {
      return author is map
        && author.uid is string
        && author.uid.size() > 0
        && author.name is string
        && author.name.size() > 0;
    }

    function validExternalBlogAuthor(author) {
      return author is map
        && author.name is string
        && author.name.size() > 0;
    }

    function validExternalBlogUrl(url) {
      return url is string
        && url.size() > 0
        && url.matches('^https://.+$');
    }

    function isExternalBlogPost(data) {
      return data.get('isExternal', false) == true;
    }

    function isDraftDoc(data) {
      return data.get('draft', false) == true;
    }

    function validOptionalDraftFlag(data) {
      return !data.keys().hasAny(['draft']) || data.draft is bool;
    }

    function validBlogPostCore(data) {
      let complete = !isDraftDoc(data);
      return validOptionalDraftFlag(data)
        && data.title is string
        && data.title.size() <= 200
        && (!complete || data.title.size() > 0)
        && data.slug is string
        && (data.slug.size() == 0 || data.slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$'))
        && (!complete || data.slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$'))
        && data.body is string
        && data.keywords is list
        && data.get('categoryId', '') is string
        && data.get('categoryId', '').size() <= 40
        && data.get('coverPatternSeed', '') is string
        && data.get('coverPatternSeed', '').size() <= 80
        && data.publishedDate is string
        && (!complete || data.publishedDate.size() > 0)
        && data.publishedTime is string
        && (!complete || data.publishedTime.size() > 0)
        && (
          (!isExternalBlogPost(data)
            && data.author is map
            && (!complete || (data.body.size() > 0 && validBlogAuthor(data.author))))
          || (isExternalBlogPost(data)
            && data.author is map
            && (!complete || (
              validExternalBlogAuthor(data.author)
              && validExternalBlogUrl(data.get('externalUrl', ''))
            )))
        );
    }

    function validBlogPostData(data) {
      return validBlogPostCore(data)
        && !isExternalBlogPost(data)
        && data.author.uid == request.auth.uid;
    }

    function validBlogPostDataAdmin(data) {
      return validBlogPostCore(data);
    }

    function blogPublishTimeUnchanged() {
      return request.resource.data.publishedDate == resource.data.publishedDate
        && request.resource.data.publishedTime == resource.data.publishedTime;
    }

    function blogAuthorUidUnchanged() {
      return request.resource.data.author.uid == resource.data.author.uid;
    }

    function blogLikeCountOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'updatedAt'])
        && request.resource.data.likeCount >= 0
        && (
          request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
          || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
        );
    }

    function blogCommentCountOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt'])
        && request.resource.data.commentCount >= 0
        && (
          request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
          || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1
        );
    }

    function siteSettingsDoc() {
      return get(/databases/$(database)/documents/siteSettings/config);
    }

    function membersCanCreateBlogPosts() {
      return !exists(/databases/$(database)/documents/siteSettings/config)
        || siteSettingsDoc().data.get('membersCanCreateBlogPosts', true) == true;
    }

    function anonymousBlogLikesEnabled() {
      return !exists(/databases/$(database)/documents/siteSettings/config)
        || siteSettingsDoc().data.get('anonymousBlogLikesEnabled', true) == true;
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow create: if isAdmin()
        && validBlogPostDataAdmin(request.resource.data)
        || (hasCompleteProfile()
          && membersCanCreateBlogPosts()
          && validBlogPostData(request.resource.data));
      allow update: if isAdmin()
        && validBlogPostDataAdmin(request.resource.data)
        || (hasCompleteProfile()
          && isBlogPostAuthor(resource.data)
          && blogAuthorUidUnchanged()
          && blogPublishTimeUnchanged()
          && validBlogPostData(request.resource.data))
        || blogLikeCountOnlyUpdate()
        || blogCommentCountOnlyUpdate();
      allow delete: if isAdmin()
        || (hasCompleteProfile() && isBlogPostAuthor(resource.data));

      match /likes/{likeId} {
        allow get, list: if true;

        allow create: if !exists(/databases/$(database)/documents/blogPosts/$(postId)/likes/$(likeId))
          && (
            (isSignedIn()
              && likeId == request.auth.uid
              && request.resource.data.keys().hasOnly(['uid', 'anonymous', 'createdAt'])
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.anonymous == false)
            || (!isSignedIn()
              && anonymousBlogLikesEnabled()
              && request.resource.data.keys().hasOnly(['uid', 'anonymous', 'createdAt'])
              && request.resource.data.anonymous == true
              && request.resource.data.uid == null
              && likeId.matches('^anon_.+$'))
          );

        allow delete: if (isSignedIn()
          && likeId == request.auth.uid
          && resource.data.anonymous == false)
          || (resource.data.anonymous == true && likeId.matches('^anon_.+$'));
      }

      match /comments/{commentId} {
        allow get, list: if true;

        allow create: if hasCompleteProfile()
          && request.resource.data.keys().hasAll(['author', 'body', 'createdAt', 'updatedAt', 'editedAt'])
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.author is map
          && request.resource.data.author.uid == request.auth.uid
          && request.resource.data.editedAt == null;

        allow update: if hasCompleteProfile()
          && resource.data.author.uid == request.auth.uid
          && request.resource.data.author == resource.data.author
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000;

        allow delete: if isAdmin()
          || (hasCompleteProfile() && resource.data.author.uid == request.auth.uid);
      }
    }

    match /organiserPresets/{presetId} {
      allow read, create, update, delete: if isAdmin();
    }

    function validNotificationColor(color) {
      return color == 'orange'
        || color == 'red'
        || color == 'blue'
        || color == 'green'
        || color == 'teal';
    }

    function validNotificationIcon(icon) {
      return icon == 'notification'
        || icon == 'important'
        || icon == 'starting'
        || icon == 'ending'
        || icon == 'warning'
        || icon == 'info';
    }

    function validNotificationData(data) {
      let complete = !isDraftDoc(data);
      return validOptionalDraftFlag(data)
        && data.title is string
        && data.title.size() <= 120
        && (!complete || data.title.size() > 0)
        && data.text is string
        && data.text.size() <= 2000
        && (!complete || data.text.size() > 0)
        && data.scheduleMode is string
        && (data.scheduleMode == 'scheduled' || data.scheduleMode == 'manual')
        && data.manualActive is bool
        && data.dateStart is string
        && data.timeStart is string
        && data.dateEnd is string
        && data.timeEnd is string
        && validNotificationColor(data.color)
        && validNotificationIcon(data.icon)
        && data.ctaEnabled is bool
        && data.ctaLabel is string
        && data.ctaHref is string
        && data.ctaOpenInNewTab is bool;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isAdmin() && validNotificationData(request.resource.data);
      allow update: if isAdmin() && validNotificationData(request.resource.data);
      allow delete: if isAdmin();
    }

    function validSiteTextsData() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'heroQuote',
          'upcomingIntro',
          'pastIntro',
          'blogIntro',
          'eventCategoryPublicLabel',
          'eventCategoryPublicDescription',
          'eventCategoryPrivateLabel',
          'eventCategoryPrivateDescription',
          'eventCategoryExternalLabel',
          'eventCategoryExternalDescription',
          'updatedAt',
        ])
        && data.heroQuote is string
        && data.upcomingIntro is string
        && data.pastIntro is string
        && data.blogIntro is string
        && data.eventCategoryPublicLabel is string
        && data.eventCategoryPublicDescription is string
        && data.eventCategoryPrivateLabel is string
        && data.eventCategoryPrivateDescription is string
        && data.eventCategoryExternalLabel is string
        && data.eventCategoryExternalDescription is string;
    }

    match /siteTexts/{docId} {
      allow read: if true;

      allow create: if isAdmin()
        && docId == 'config'
        && validSiteTextsData();

      allow update: if isAdmin()
        && docId == 'config'
        && validSiteTextsData();

      allow delete: if false;
    }

    match /appTexts/{docId} {
      allow read: if true;

      allow create: if isAdmin()
        && docId == 'config'
        && validAppTextsData();

      allow update: if isAdmin()
        && docId == 'config'
        && validAppTextsData();

      allow delete: if false;
    }

    function validAppTextsData() {
      let data = request.resource.data;
      return data.keys().hasOnly(['overrides', 'updatedAt'])
        && data.overrides is map
        && data.overrides.size() <= 600;
    }

    function isProtectedPage(pageId) {
      return pageId == 'home'
        || pageId == 'vypukne'
        || pageId == 'probehle'
        || pageId == 'blog'
        || pageId == 'odkazy'
        || pageId == 'publikace'
        || pageId == 'coming-soon'
        || pageId == '404';
    }

    function validPageType(type) {
      return type == 'home'
        || type == 'events-upcoming'
        || type == 'events-past'
        || type == 'blog-list'
        || type == 'links-list'
        || type == 'publications-list'
        || type == 'content';
    }

    function validPageSlug(slug) {
      return slug == ''
        || slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    function validPageBlocks(blocks) {
      return blocks is list
        && blocks.size() <= 50;
    }

    function validPageFields() {
      let data = request.resource.data;
      return data.keys().hasAll(['slug', 'title', 'type'])
        && data.title is string
        && data.title.size() > 0
        && data.slug is string
        && data.type is string
        && validPageType(data.type)
        && validPageSlug(data.slug)
        && (data.type != 'home' || data.slug == '')
        && (data.type == 'home' || data.slug.size() > 0)
        && (!data.keys().hasAny(['blocks']) || validPageBlocks(data.blocks))
        && (!data.keys().hasAny(['intro']) || data.intro is string)
        && (!data.keys().hasAny(['seoTitle']) || data.seoTitle is string)
        && (!data.keys().hasAny(['seoDescription']) || data.seoDescription is string);
    }

    function validSiteSettingsFooterSlot(slot) {
      return slot is map
        && slot.keys().hasOnly(['preset', 'enabled'])
        && slot.preset is string
        && slot.enabled is bool;
    }

    function validSiteSettingsFooterSlots(slots) {
      return slots is list
        && slots.size() == 3
        && validSiteSettingsFooterSlot(slots[0])
        && validSiteSettingsFooterSlot(slots[1])
        && validSiteSettingsFooterSlot(slots[2]);
    }

    function validSiteSettingsBrandLinks(links) {
      return links is map
        && links.keys().hasOnly(['instagram', 'facebook', 'mail', 'youtube', 'tiktok', 'linkedin'])
        && links.instagram is string
        && links.facebook is string
        && links.mail is string
        && links.youtube is string
        && links.tiktok is string
        && links.linkedin is string;
    }

    function validBlogNotifyEmails(emails) {
      return emails is list
        && emails.size() <= 50;
    }

    function validResourceCategoryItem(item) {
      return item is map
        && item.keys().hasOnly(['id', 'label'])
        && item.id is string
        && item.id.size() > 0
        && item.id.size() <= 40
        && item.label is string
        && item.label.size() > 0
        && item.label.size() <= 80;
    }

    function validEventStampItem(item) {
      return item is map
        && item.keys().hasOnly(['id', 'icon', 'name'])
        && item.id is string
        && item.id.size() > 0
        && item.id.size() <= 64
        && item.icon is string
        && item.icon.size() > 0
        && item.icon.size() <= 32
        && item.name is string
        && item.name.size() > 0
        && item.name.size() <= 80;
    }

    function validEventStampsList(stamps) {
      return stamps is list
        && stamps.size() <= 24
        && (
          stamps.size() == 0
          || (
            validEventStampItem(stamps[0])
            && (stamps.size() < 2 || validEventStampItem(stamps[1]))
            && (stamps.size() < 3 || validEventStampItem(stamps[2]))
            && (stamps.size() < 4 || validEventStampItem(stamps[3]))
            && (stamps.size() < 5 || validEventStampItem(stamps[4]))
            && (stamps.size() < 6 || validEventStampItem(stamps[5]))
            && (stamps.size() < 7 || validEventStampItem(stamps[6]))
            && (stamps.size() < 8 || validEventStampItem(stamps[7]))
            && (stamps.size() < 9 || validEventStampItem(stamps[8]))
            && (stamps.size() < 10 || validEventStampItem(stamps[9]))
            && (stamps.size() < 11 || validEventStampItem(stamps[10]))
            && (stamps.size() < 12 || validEventStampItem(stamps[11]))
            && (stamps.size() < 13 || validEventStampItem(stamps[12]))
            && (stamps.size() < 14 || validEventStampItem(stamps[13]))
            && (stamps.size() < 15 || validEventStampItem(stamps[14]))
            && (stamps.size() < 16 || validEventStampItem(stamps[15]))
            && (stamps.size() < 17 || validEventStampItem(stamps[16]))
            && (stamps.size() < 18 || validEventStampItem(stamps[17]))
            && (stamps.size() < 19 || validEventStampItem(stamps[18]))
            && (stamps.size() < 20 || validEventStampItem(stamps[19]))
            && (stamps.size() < 21 || validEventStampItem(stamps[20]))
            && (stamps.size() < 22 || validEventStampItem(stamps[21]))
            && (stamps.size() < 23 || validEventStampItem(stamps[22]))
            && (stamps.size() < 24 || validEventStampItem(stamps[23]))
          )
        );
    }

    function validResourceCategoriesList(categories) {
      return categories is list
        && categories.size() <= 40
        && (
          categories.size() == 0
          || (
            validResourceCategoryItem(categories[0])
            && (categories.size() < 2 || validResourceCategoryItem(categories[1]))
            && (categories.size() < 3 || validResourceCategoryItem(categories[2]))
            && (categories.size() < 4 || validResourceCategoryItem(categories[3]))
            && (categories.size() < 5 || validResourceCategoryItem(categories[4]))
            && (categories.size() < 6 || validResourceCategoryItem(categories[5]))
            && (categories.size() < 7 || validResourceCategoryItem(categories[6]))
            && (categories.size() < 8 || validResourceCategoryItem(categories[7]))
            && (categories.size() < 9 || validResourceCategoryItem(categories[8]))
            && (categories.size() < 10 || validResourceCategoryItem(categories[9]))
            && (categories.size() < 11 || validResourceCategoryItem(categories[10]))
            && (categories.size() < 12 || validResourceCategoryItem(categories[11]))
            && (categories.size() < 13 || validResourceCategoryItem(categories[12]))
            && (categories.size() < 14 || validResourceCategoryItem(categories[13]))
            && (categories.size() < 15 || validResourceCategoryItem(categories[14]))
            && (categories.size() < 16 || validResourceCategoryItem(categories[15]))
            && (categories.size() < 17 || validResourceCategoryItem(categories[16]))
            && (categories.size() < 18 || validResourceCategoryItem(categories[17]))
            && (categories.size() < 19 || validResourceCategoryItem(categories[18]))
            && (categories.size() < 20 || validResourceCategoryItem(categories[19]))
            && (categories.size() < 21 || validResourceCategoryItem(categories[20]))
            && (categories.size() < 22 || validResourceCategoryItem(categories[21]))
            && (categories.size() < 23 || validResourceCategoryItem(categories[22]))
            && (categories.size() < 24 || validResourceCategoryItem(categories[23]))
            && (categories.size() < 25 || validResourceCategoryItem(categories[24]))
            && (categories.size() < 26 || validResourceCategoryItem(categories[25]))
            && (categories.size() < 27 || validResourceCategoryItem(categories[26]))
            && (categories.size() < 28 || validResourceCategoryItem(categories[27]))
            && (categories.size() < 29 || validResourceCategoryItem(categories[28]))
            && (categories.size() < 30 || validResourceCategoryItem(categories[29]))
            && (categories.size() < 31 || validResourceCategoryItem(categories[30]))
            && (categories.size() < 32 || validResourceCategoryItem(categories[31]))
            && (categories.size() < 33 || validResourceCategoryItem(categories[32]))
            && (categories.size() < 34 || validResourceCategoryItem(categories[33]))
            && (categories.size() < 35 || validResourceCategoryItem(categories[34]))
            && (categories.size() < 36 || validResourceCategoryItem(categories[35]))
            && (categories.size() < 37 || validResourceCategoryItem(categories[36]))
            && (categories.size() < 38 || validResourceCategoryItem(categories[37]))
            && (categories.size() < 39 || validResourceCategoryItem(categories[38]))
            && (categories.size() < 40 || validResourceCategoryItem(categories[39]))
          )
        );
    }

    function validSiteSettingsPatch() {
      let data = request.resource.data;
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly([
          'logoUrl',
          'logoPublicId',
          'logoAlt',
          'brandLine1',
          'brandLine2',
          'footerYear',
          'footerContactLabel',
          'footerContactEmail',
          'brandLinks',
          'footerSocialSlots',
          'comingSoonEnabled',
          'comingSoonBypassLocalhost',
          'anonymousBlogLikesEnabled',
          'membersCanCreateBlogPosts',
          'blogNotifyEmails',
          'blogCategories',
          'publicationCategories',
          'usefulLinkCategories',
          'eventCategoryPublicLabel',
          'eventCategoryPublicDescription',
          'eventCategoryPrivateLabel',
          'eventCategoryPrivateDescription',
          'eventCategoryExternalLabel',
          'eventCategoryExternalDescription',
          'eventStamps',
          'updatedAt',
        ])
        && (!keys.hasAny(['logoUrl']) || data.logoUrl is string)
        && (!keys.hasAny(['logoPublicId']) || data.logoPublicId is string)
        && (!keys.hasAny(['logoAlt']) || data.logoAlt is string)
        && (!keys.hasAny(['brandLine1']) || data.brandLine1 is string)
        && (!keys.hasAny(['brandLine2']) || data.brandLine2 is string)
        && (!keys.hasAny(['footerYear']) || data.footerYear is string)
        && (!keys.hasAny(['footerContactLabel']) || data.footerContactLabel is string)
        && (!keys.hasAny(['footerContactEmail']) || data.footerContactEmail is string)
        && (!keys.hasAny(['brandLinks']) || validSiteSettingsBrandLinks(data.brandLinks))
        && (!keys.hasAny(['footerSocialSlots']) || validSiteSettingsFooterSlots(data.footerSocialSlots))
        && (!keys.hasAny(['comingSoonEnabled']) || data.comingSoonEnabled is bool)
        && (!keys.hasAny(['comingSoonBypassLocalhost']) || data.comingSoonBypassLocalhost is bool)
        && (!keys.hasAny(['anonymousBlogLikesEnabled']) || data.anonymousBlogLikesEnabled is bool)
        && (!keys.hasAny(['membersCanCreateBlogPosts']) || data.membersCanCreateBlogPosts is bool)
        && (!keys.hasAny(['blogNotifyEmails']) || validBlogNotifyEmails(data.blogNotifyEmails))
        && (!keys.hasAny(['blogCategories']) || validResourceCategoriesList(data.blogCategories))
        && (!keys.hasAny(['publicationCategories']) || validResourceCategoriesList(data.publicationCategories))
        && (!keys.hasAny(['usefulLinkCategories']) || validResourceCategoriesList(data.usefulLinkCategories))
        && (!keys.hasAny(['eventCategoryPublicLabel']) || data.eventCategoryPublicLabel is string)
        && (!keys.hasAny(['eventCategoryPublicDescription']) || data.eventCategoryPublicDescription is string)
        && (!keys.hasAny(['eventCategoryPrivateLabel']) || data.eventCategoryPrivateLabel is string)
        && (!keys.hasAny(['eventCategoryPrivateDescription']) || data.eventCategoryPrivateDescription is string)
        && (!keys.hasAny(['eventCategoryExternalLabel']) || data.eventCategoryExternalLabel is string)
        && (!keys.hasAny(['eventCategoryExternalDescription']) || data.eventCategoryExternalDescription is string)
        && (!keys.hasAny(['eventStamps']) || validEventStampsList(data.eventStamps));
    }

    function validSiteSettingsCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'logoUrl',
          'logoPublicId',
          'logoAlt',
          'brandLine1',
          'brandLine2',
          'footerYear',
          'footerContactLabel',
          'footerContactEmail',
          'brandLinks',
          'footerSocialSlots',
          'comingSoonEnabled',
          'comingSoonBypassLocalhost',
          'anonymousBlogLikesEnabled',
          'membersCanCreateBlogPosts',
          'blogNotifyEmails',
          'blogCategories',
          'publicationCategories',
          'usefulLinkCategories',
          'eventCategoryPublicLabel',
          'eventCategoryPublicDescription',
          'eventCategoryPrivateLabel',
          'eventCategoryPrivateDescription',
          'eventCategoryExternalLabel',
          'eventCategoryExternalDescription',
          'eventStamps',
          'updatedAt',
        ])
        && data.logoUrl is string
        && data.logoPublicId is string
        && data.logoAlt is string
        && data.brandLine1 is string
        && data.brandLine2 is string
        && data.footerYear is string
        && data.footerContactLabel is string
        && data.footerContactEmail is string
        && validSiteSettingsBrandLinks(data.brandLinks)
        && validSiteSettingsFooterSlots(data.footerSocialSlots)
        && data.comingSoonEnabled is bool
        && data.comingSoonBypassLocalhost is bool
        && data.anonymousBlogLikesEnabled is bool
        && data.membersCanCreateBlogPosts is bool
        && validBlogNotifyEmails(data.get('blogNotifyEmails', []))
        && validResourceCategoriesList(data.get('blogCategories', []))
        && validResourceCategoriesList(data.get('publicationCategories', []))
        && validResourceCategoriesList(data.get('usefulLinkCategories', []))
        && data.eventCategoryPublicLabel is string
        && data.eventCategoryPublicDescription is string
        && data.eventCategoryPrivateLabel is string
        && data.eventCategoryPrivateDescription is string
        && data.eventCategoryExternalLabel is string
        && data.eventCategoryExternalDescription is string
        && validEventStampsList(data.get('eventStamps', []));
    }

    match /siteSettings/{docId} {
      allow read: if true;

      allow create: if isAdmin()
        && docId == 'config'
        && validSiteSettingsCreate();

      allow update: if isAdmin()
        && docId == 'config'
        && validSiteSettingsPatch();

      allow delete: if false;
    }

    match /pages/{pageId} {
      allow read: if true;

      allow create: if isAdmin() && validPageFields();

      allow update: if isAdmin()
        && validPageFields()
        && request.resource.data.type == resource.data.type
        && (pageId != 'home' && pageId != 'coming-soon' && pageId != '404'
          || (pageId == 'home'
            && request.resource.data.title == resource.data.title
            && request.resource.data.slug == resource.data.slug)
          || (pageId == 'coming-soon'
            && request.resource.data.slug == resource.data.slug)
          || (pageId == '404'
            && request.resource.data.slug == resource.data.slug
            && request.resource.data.title == resource.data.title));

      allow delete: if isAdmin() && !isProtectedPage(pageId);
    }

    match /siteMenu/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && docId == 'config';
      allow delete: if false;
    }

    function validHexColor(value) {
      return value is string
        && value.matches('^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$');
    }

    function validSiteColorMap(colors) {
      return colors is map
        && validHexColor(colors.orange)
        && validHexColor(colors.orangeLight)
        && validHexColor(colors.orangeDark)
        && validHexColor(colors.orangePale)
        && validHexColor(colors.red)
        && validHexColor(colors.redLight)
        && validHexColor(colors.redPale)
        && validHexColor(colors.blue)
        && validHexColor(colors.blueLight)
        && validHexColor(colors.bluePale)
        && validHexColor(colors.green)
        && validHexColor(colors.greenLight)
        && validHexColor(colors.greenPale)
        && validHexColor(colors.teal)
        && validHexColor(colors.tealLight)
        && validHexColor(colors.tealPale)
        && validHexColor(colors.yellow)
        && validHexColor(colors.yellowPale)
        && validHexColor(colors.black)
        && validHexColor(colors.white)
        && validHexColor(colors.offWhite)
        && validHexColor(colors.gray)
        && validHexColor(colors.grayMuted);
    }

    function validSiteColorsData() {
      let data = request.resource.data;
      return data.keys().hasOnly(['colors', 'updatedAt'])
        && validSiteColorMap(data.colors);
    }

    match /siteColors/{docId} {
      allow read: if true;

      allow create: if isAdmin()
        && docId == 'config'
        && validSiteColorsData();

      allow update: if isAdmin()
        && docId == 'config'
        && validSiteColorsData();

      allow delete: if false;
    }

    function validAnalyticsDevice(device) {
      return device == 'mobile' || device == 'tablet' || device == 'desktop';
    }

    function validAnalyticsType(type) {
      return type == 'page_view'
        || type == 'engagement'
        || type == 'article_view'
        || type == 'event_view'
        || type == 'social_click'
        || type == 'nav_click'
        || type == 'outbound_click'
        || type == 'notification_click'
        || type == 'contact_click'
        || type == 'blog_like'
        || type == 'blog_comment';
    }

    function validAnalyticsEventData(data) {
      return data.keys().hasOnly([
          'type',
          'sessionId',
          'path',
          'device',
          'os',
          'browser',
          'articleSlug',
          'eventId',
          'eventSlug',
          'clickTarget',
          'clickLabel',
          'durationSec',
          'createdAt',
        ])
        && validAnalyticsType(data.type)
        && data.sessionId is string
        && data.sessionId.size() >= 8
        && data.sessionId.size() <= 80
        && data.path is string
        && data.path.size() > 0
        && data.path.size() <= 240
        && validAnalyticsDevice(data.device)
        && data.os is string
        && data.os.size() <= 32
        && data.browser is string
        && data.browser.size() <= 32
        && data.articleSlug is string
        && data.articleSlug.size() <= 120
        && data.eventId is string
        && data.eventId.size() <= 80
        && data.eventSlug is string
        && data.eventSlug.size() <= 120
        && data.clickTarget is string
        && data.clickTarget.size() <= 120
        && data.clickLabel is string
        && data.clickLabel.size() <= 200
        && data.durationSec is number
        && data.durationSec >= 0
        && data.durationSec <= 120;
    }

    function validKeywordsList(keywords) {
      return keywords is list && keywords.size() <= 15;
    }

    function validUsefulLinkData(data) {
      let complete = !isDraftDoc(data);
      return data.keys().hasOnly([
          'title',
          'url',
          'description',
          'keywords',
          'categoryId',
          'createdAt',
          'updatedAt',
          'draft',
        ])
        && validOptionalDraftFlag(data)
        && data.title is string
        && data.title.size() <= 120
        && (!complete || data.title.size() > 0)
        && data.url is string
        && data.url.size() <= 500
        && (data.url.size() == 0 || data.url.matches('^https?://.+'))
        && (!complete || (data.url.size() > 0 && data.url.matches('^https?://.+')))
        && data.description is string
        && data.description.size() <= 200
        && validKeywordsList(data.keywords)
        && data.get('categoryId', '') is string
        && data.get('categoryId', '').size() <= 40;
    }

    function validPublicationData(data) {
      let complete = !isDraftDoc(data);
      return data.keys().hasOnly([
          'title',
          'author',
          'description',
          'keywords',
          'categoryId',
          'createdAt',
          'updatedAt',
          'draft',
        ])
        && validOptionalDraftFlag(data)
        && data.title is string
        && data.title.size() <= 120
        && (!complete || data.title.size() > 0)
        && data.author is string
        && data.author.size() <= 120
        && data.description is string
        && data.description.size() <= 400
        && validKeywordsList(data.keywords)
        && data.get('categoryId', '') is string
        && data.get('categoryId', '').size() <= 40;
    }

    // Useful links & publications (admin CRUD, public read)
    match /usefulLinks/{linkId} {
      allow get, list: if true;
      allow create: if isAdmin() && validUsefulLinkData(request.resource.data);
      allow update: if isAdmin() && validUsefulLinkData(request.resource.data);
      allow delete: if isAdmin();
    }

    match /publications/{publicationId} {
      allow get, list: if true;
      allow create: if isAdmin() && validPublicationData(request.resource.data);
      allow update: if isAdmin() && validPublicationData(request.resource.data);
      allow delete: if isAdmin();
    }

    match /analyticsEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if validAnalyticsEventData(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    function validAdminActivityLogData(data) {
      return data.keys().hasAll(['actorUid', 'actorName', 'summary', 'createdAt'])
        && data.actorUid is string
        && data.actorUid.size() > 0
        && data.actorName is string
        && data.actorName.size() > 0
        && data.summary is string
        && data.summary.size() > 0
        && data.summary.size() <= 500
        && (!data.keys().hasAny(['action']) || data.action is string)
        && (!data.keys().hasAny(['targetType']) || data.targetType is string)
        && (!data.keys().hasAny(['targetId']) || data.targetId is string);
    }

    match /adminActivityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validAdminActivityLogData(request.resource.data);
      allow update, delete: if false;
    }
  }
}
